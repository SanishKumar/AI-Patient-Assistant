BETTER_AUTH_URL=http://127.0.0.1:3000
# setup:local generates both secrets; setup:deployment creates .env.production.
BETTER_AUTH_SECRET=
AETHER_DATA_KEY=
AETHER_DATABASE_PATH=.data/aether.sqlite
# Development only. Public deployment must disable this and configure SMTP.
AETHER_LOCAL_ACCOUNTS=1
AETHER_PUBLIC_ACCOUNTS=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
